     return re.sub(r'[\s*`|#>]', '', text)
 
 
+def source_span(source, text):
+    """Locate a unique spelling after reversible whitespace/Markdown cleanup.
+
+    Never discard words, punctuation, negation, or table delimiters. Return raw
+    offsets so rendered citations retain the original bytes and formatting.
+    """
+    position = source.find(text)
+    if position >= 0:
+        return position, position + len(text)
+    def visible(value):
+        hidden = set()
+        for match in re.finditer(r"(\*\*|`)(.+?)\1", value, re.S):
+            size = len(match.group(1))
+            hidden.update(range(match.start(), match.start() + size))
+            hidden.update(range(match.end() - size, match.end()))
+        chars, offsets = [], []
+        for index, char in enumerate(value):
+            if index in hidden:
+                continue
+            char = ' ' if char.isspace() else char
+            if char == ' ' and chars and chars[-1] == ' ':
+                continue
+            chars.append(char); offsets.append(index)
+        return ''.join(chars), offsets
+    raw, offsets = visible(source)
+    needle, _ = visible(text)
+    if not needle.strip():
+        return None
+    at = raw.find(needle)
+    if at < 0 or raw.find(needle, at + 1) >= 0:
+        return None
+    return offsets[at], offsets[at + len(needle) - 1] + 1
+
